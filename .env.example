PORT=3000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=ai_platform
DB_SSL=false

# Provider Selection
AI_PROVIDER=openai

# OpenAI-Compatible / OpenRouter Configuration
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=your-openrouter-api-key-here
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Primary and Automatic Failover Models
OPENAI_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENAI_FALLBACK_MODELS=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_SITE_URL=https://shaiviktechnologies.in
OPENROUTER_APP_NAME=Shaivik AI SaaS

# Rate Limiting & Concurrency Controls
OPENROUTER_RPM=20
OPENROUTER_MAX_CONCURRENCY=5
OPENAI_RATE_LIMIT_WAIT_MS=25000
OPENAI_QUEUE_TIMEOUT_MS=30000
MODEL_FAILOVER_COOLDOWN_MS=60000

# Ollama Local Fallback (Optional)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_THINK=false
